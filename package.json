{
  "name": "arka-cdn",
  "version": "0.1.0",
  "description": "ArkaCDN – high-level CDN client for the Arkiv network: chunked uploads, multi-wallet, P2P AES encryption, browser + Node compatible.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.mts",
      "import": "./dist/crypto/index.mjs",
      "require": "./dist/crypto/index.cjs"
    },
    "./upload": {
      "types": "./dist/upload/index.d.mts",
      "import": "./dist/upload/index.mjs",
      "require": "./dist/upload/index.cjs"
    },
    "./download": {
      "types": "./dist/download/index.d.mts",
      "import": "./dist/download/index.mjs",
      "require": "./dist/download/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./entity": {
      "types": "./dist/entity/index.d.mts",
      "import": "./dist/entity/index.mjs",
      "require": "./dist/entity/index.cjs"
    },
    "./file": {
      "types": "./dist/file/index.d.mts",
      "import": "./dist/file/index.mjs",
      "require": "./dist/file/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "bumpp",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@arkiv-network/sdk": "latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "bumpp": "^10.0.0",
    "eslint": "^9.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "arkiv",
    "cdn",
    "decentralized",
    "storage",
    "encryption",
    "chunked-upload",
    "p2p"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/arkiv-cdn"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  }
}