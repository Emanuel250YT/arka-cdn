{
  "name": "arka-cdn",
  "version": "0.1.2-beta.9",
  "description": "ArkaCDN – high-level CDN client for the Arkiv network: chunked uploads, multi-wallet, P2P AES encryption, browser + Node compatible.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto/index.d.ts",
        "default": "./dist/crypto/index.js"
      },
      "require": {
        "types": "./dist/crypto/index.d.cts",
        "default": "./dist/crypto/index.cjs"
      }
    },
    "./upload": {
      "import": {
        "types": "./dist/upload/index.d.ts",
        "default": "./dist/upload/index.js"
      },
      "require": {
        "types": "./dist/upload/index.d.cts",
        "default": "./dist/upload/index.cjs"
      }
    },
    "./download": {
      "import": {
        "types": "./dist/download/index.d.ts",
        "default": "./dist/download/index.js"
      },
      "require": {
        "types": "./dist/download/index.d.cts",
        "default": "./dist/download/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./entity": {
      "import": {
        "types": "./dist/entity/index.d.ts",
        "default": "./dist/entity/index.js"
      },
      "require": {
        "types": "./dist/entity/index.d.cts",
        "default": "./dist/entity/index.cjs"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/file/index.d.ts",
        "default": "./dist/file/index.js"
      },
      "require": {
        "types": "./dist/file/index.d.cts",
        "default": "./dist/file/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "bumpp",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@arkiv-network/sdk": "latest"
  },
  "peerDependencies": {
    "ffmpeg-static": "^5.0.0",
    "fluent-ffmpeg": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "fluent-ffmpeg": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^3.0.0",
    "bumpp": "^10.0.0",
    "eslint": "^9.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "arkiv",
    "cdn",
    "decentralized",
    "storage",
    "encryption",
    "chunked-upload",
    "p2p"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emanuel250YT/arka-cdn"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "crypto": [
        "./dist/crypto/index.d.ts"
      ],
      "upload": [
        "./dist/upload/index.d.ts"
      ],
      "download": [
        "./dist/download/index.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "entity": [
        "./dist/entity/index.d.ts"
      ],
      "file": [
        "./dist/file/index.d.ts"
      ]
    }
  }
}