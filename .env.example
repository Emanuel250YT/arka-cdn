# Database
DATABASE_URL="postgresql://user:password@localhost:5432/openleague?schema=public"

# Application
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Email Configuration (Gmail example)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Coinbase CDP Configuration
CDP_API_KEY_ID="your-coinbase-cdp-api-key-id"
CDP_API_KEY_SECRET="your-coinbase-cdp-api-key-secret"

# Blockchain
PRIVATE_KEY=your_private_key_here
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Contract Addresses (after deployment)
CONTRACT_ADDRESS=

# Arkiv Network Configuration
# WALLET MANAGEMENT:
# The application now uses wallets.json for wallet management by default.
# Generate wallets with: node scripts/generate-wallets.js <count>
# The wallets will be automatically distributed using round-robin for load balancing.
# 
# FALLBACK (Optional):
# If wallets.json is not available, the system will fallback to environment variables below.
# You can configure multiple wallets by adding numbered keys (ARKIV_PRIVATE_KEY_2, ARKIV_PRIVATE_KEY_3, etc.)
# 
# Private key for Arkiv Network (hex format WITHOUT 0x prefix)
ARKIV_PRIVATE_KEY=your_arkiv_private_key_in_hex_without_0x
# Additional wallets (optional, only used if wallets.json is not available)
# ARKIV_PRIVATE_KEY_2=your_second_private_key
# ARKIV_PRIVATE_KEY_3=your_third_private_key

# Optional override: specify a custom wallets file path (relative to project root)
# Defaults to `wallets.json` in the project root.
# Example: ARKIV_WALLETS_FILE=secrets/wallets.json
ARKIV_WALLETS_FILE=wallets.json

